# 统一行尾，避免不同系统提交时产生整文件 diff
# Normalize line endings so cross-platform commits don't diff whole files.
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
gradlew text eol=lf
gradlew.bat text eol=crlf

# 二进制：不做行尾转换，也不尝试文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.jar   binary
*.jks   binary
*.apk   binary
*.zip   binary
*.db    binary
