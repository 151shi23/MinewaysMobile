<?xml version="1.0" encoding="utf-8"?>
<!-- AI 动画助手（独立界面）：自然语言 → Blockbench 动画 JSON / Snowstorm 粒子 JSON / Molang 表达式 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/ai_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="@string/ai_title"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_target_label"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_ai_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_ai_anim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/ai_target_anim" />

                <RadioButton
                    android:id="@+id/rb_ai_particle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_target_particle" />

                <RadioButton
                    android:id="@+id/rb_ai_molang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_target_molang" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ai_desc_label"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_ai_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/ai_desc_hint"
                android:minLines="3"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_ai_length"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/ai_length_hint"
                    android:inputType="numberDecimal"
                    android:text="3"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_ai_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/ai_name_hint"
                    android:inputType="text"
                    android:text="logo"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ai_api_label"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_ai_endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ai_endpoint_hint"
                android:inputType="textUri"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_ai_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ai_model_hint"
                android:inputType="text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_ai_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ai_key_hint"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai_generate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/ai_generate" />

            <TextView
                android:id="@+id/tv_ai_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_ai_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#15171B"
                android:editable="false"
                android:fontFamily="monospace"
                android:gravity="top"
                android:minLines="10"
                android:padding="8dp"
                android:textColor="#E8EAED"
                android:textColorHint="#888888"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_copy"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="46dp"
                    android:text="@string/ai_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_save"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minHeight="46dp"
                    android:text="@string/ai_save" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
